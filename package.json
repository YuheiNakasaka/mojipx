{
  "name": "mojipx",
  "version": "0.2.0",
  "description": "Building blocks for making browser games with a pixel-art look",
  "keywords": [
    "pixel-art",
    "retro",
    "game",
    "sprite",
    "canvas",
    "react",
    "web-audio",
    "chiptune"
  ],
  "author": "Yuhei Nakasaka",
  "license": "MIT",
  "homepage": "https://github.com/YuheiNakasaka/mojipx#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/YuheiNakasaka/mojipx.git"
  },
  "bugs": {
    "url": "https://github.com/YuheiNakasaka/mojipx/issues"
  },
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./react": {
      "types": "./dist/react/index.d.ts",
      "default": "./dist/react/index.js"
    },
    "./styles.css": "./dist/styles.css"
  },
  "files": [
    "dist",
    "docs"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json && cp src/styles.css dist/styles.css",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "prepare": "npm run build",
    "prepublishOnly": "npm run lint && npm run typecheck && npm test"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.6",
    "@types/node": "^26.5.1",
    "@types/react": "^19.2.18",
    "react": "19.2.8",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  }
}
